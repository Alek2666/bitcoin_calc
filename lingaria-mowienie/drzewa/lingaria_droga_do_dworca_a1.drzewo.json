      "wzor": "Jadę do stolicy odwiedzić przyjaciółkę.",
      "blad": "Przepraszam, pytałam, dokąd jedziesz.",
      "dalej": "op2"
    },
    "op2": {
      "kto": "ai",
      "opis": true,
      "jezyk_ucznia": true,
      "tekst": "Wskazówka: kierunki to proste słowa: prosto, w lewo, w prawo. Warto je znać na pamięć, bo przydają się w każdym mieście.",
      "dalej": "p1"
    },
    "p1": {
      "kto": "uczen",
