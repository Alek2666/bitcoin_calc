  "wezly": {
    "op1": {
      "kto": "ai",
      "opis": true,
      "tekst": "Stoisz na ulicy w obcym mieście. Szukasz dworca kolejowego, ale nie masz mapy. Obok idzie przyjazna kobieta.",
      "dalej": "u1"
    },
    "u1": {
      "kto": "uczen",
      "instrukcja": "Zatrzymaj tę osobę i zapytaj, gdzie jest dworzec",
      "wzor": "Przepraszam, gdzie jest dworzec?",
      "blad": "Słucham? Czego szukasz?",
      "dalej": "s1"
    },
    "s1": {
      "kto": "ai",
      "tekst": "Dworzec? To niedaleko. Idź prosto tą ulicą aż do skrzyżowania. Rozumiesz?",
      "instrukcja": "Powiedz, czy rozumiesz",
      "blad": "Przepraszam, rozumiesz? Prosto aż do skrzyżowania.",
      "galezie": [
        {
          "intencja": "tak",
          "wzor": "Tak, rozumiem. Prosto do skrzyżowania.",
          "dalej": "a1"
        },
        {
          "intencja": "nie",
          "wzor": "Przepraszam, nie rozumiem. Powtórz, proszę.",
          "dalej": "a2"
        },
        {
          "intencja": "taxi",
          "wzor": "Czy mogę pojechać taksówką?",
          "dalej": "a3",
          "ukryta": true
        }
      ]
    },
    "a2": {
      "kto": "ai",
      "tekst": "Dobrze. Jeszcze raz, powoli: prosto, aż do skrzyżowania.",
      "dalej": "a1"
    },
    "a3": {
      "kto": "ai",
      "tekst": "Oczywiście, ale pieszo to tylko pięć minut.",
      "dalej": "a1"
    },
    "a1": {
      "kto": "ai",
      "tekst": "Na skrzyżowaniu skręć w lewo. Zobaczysz dużą aptekę. Dworzec jest zaraz za nią.",
      "dalej": "s2"
    },
    "s2": {
      "kto": "ai",
      "tekst": "A teraz sprawdźmy. Gdzie skręcasz na skrzyżowaniu?",
      "instrukcja": "Powiedz, gdzie skręcasz",
      "blad": "Przepraszam, w którą stronę skręcasz?",
      "galezie": [
        {
          "intencja": "lewo",
          "wzor": "W lewo, przy aptece.",
          "dalej": "a4"
        },
        {
          "intencja": "prawo",
          "wzor": "W prawo.",
          "dalej": "a5"
        },
        {
          "intencja": "niewiem",
          "wzor": "Nie wiem, gdzie jestem.",
          "dalej": "a8"
        }
      ]
    },
    "a5": {
      "kto": "ai",
      "tekst": "Nie, w lewo! W prawo jest rzeka.",
      "dalej": "a4"
    },
    "a8": {
      "kto": "ai",
      "tekst": "Spokojnie, pokażę ci to na mapie w telefonie.",
      "dalej": "fin2"
    },
    "a4": {
      "kto": "ai",
      "tekst": "Dokładnie! Dworzec jest po prawej stronie, za apteką.",
      "dalej": "u2"
    },
    "u2": {
      "kto": "uczen",
      "instrukcja": "Zapytaj, czy to daleko",
      "wzor": "Czy to daleko stąd?",
      "blad": "Słucham?",
      "dalej": "a6"
    },
    "a6": {
      "kto": "ai",
      "tekst": "Nie, tylko pięć minut pieszo. A ty? Dokąd jedziesz pociągiem?",
      "dalej": "sw1"
    },
    "sw1": {
      "kto": "uczen",
      "swobodna": true,
      "instrukcja": "Powiedz, dokąd jedziesz i po co",
